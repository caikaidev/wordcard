{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordcard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // 前端静态资源（vite build 输出），/api/* 先交给 Worker 处理
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Gemini API 不支持中国香港等地区；中国大陆访问 Cloudflare 常落在香港节点，
  // 所以把 Worker 固定跑在美国，避免 "User location is not supported"。
  "placement": { "region": "gcp:us-central1" },

  // 绑定自定义域名后可改为 false，并在下方 routes 里填域名
  "workers_dev": true,
  // "routes": [{ "pattern": "words.example.com", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordcard",
      // 首次部署前运行 `npx wrangler d1 create wordcard`，把输出的 id 填到这里
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "wordcard-audio" }],

  "vars": {
    "GEMINI_TEXT_MODEL": "gemini-3.8-flash",
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts",
    "GEMINI_VOICE": "Kore",
    // 费用闸门：每天最多多少次 AI 调用（失败也计数），超出返回 429；AI_DISABLED 设为 "true" 可一键停用
    "DAILY_TEXT_LIMIT": "300",
    // 语音上限对齐 Gemini TTS 第 1 层级（每天 100 次、每分钟 10 次），留一点余量
    "DAILY_TTS_LIMIT": "90",
    "PER_MINUTE_LIMIT": "40",
    "TTS_PER_MINUTE_LIMIT": "8",
    "AI_DISABLED": "false",
    // Cloudflare Access（Worker → Access 页面的“应用程序值”），不是密码，可以公开
    "ACCESS_TEAM_DOMAIN": "caikai.cloudflareaccess.com",
    "ACCESS_AUD": "25addfc0a956b5762deabf87d9264524cadaf8b2ae97cb1ec701ecebad47ad21"
  },

  "observability": { "enabled": true }
}
