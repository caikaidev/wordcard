{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordcard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // 前端静态资源（vite build 输出），/api/* 先交给 Worker 处理
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 请求路由设置：让 Worker 在美国的数据中心执行，出站请求（如调用 Gemini）从那里发出，
  // 避免落在 Gemini 不支持的地区时报 "User location is not supported"。
  // 这只是技术上的执行位置设置，不代表任何地区的合规方案。
  "placement": { "region": "gcp:us-central1" },

  // 绑定自定义域名后可改为 false，并在下方 routes 里填域名
  "workers_dev": true,
  // "routes": [{ "pattern": "words.example.com", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordcard",
      // 首次部署前运行 `npx wrangler d1 create wordcard`，把输出的 id 填到这里
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "wordcard-audio" }],
  "ai": { "binding": "AI" }, // MeloTTS 直接调用 Workers AI，不需要另一把 API key

  // Browser Run（原 Browser Rendering）：读链接时，直接抓取读不到正文的页面用真实浏览器渲染。
  // 免费版每天 10 分钟浏览器时间；不想用可以删掉这一段，读取会跳过这一步。
  "browser": { "binding": "BROWSER" },

  "vars": {
    "GEMINI_TEXT_MODEL": "gemini-3.8-flash",
    // 历史设置兼容保留：TTS 语音生成已默认切换到 Cloudflare MeloTTS，不再调用以下 Gemini 配置。
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts",
    "GEMINI_VOICE": "Kore",
    // 费用闸门：每天最多多少次 AI 调用（失败也计数），超出返回 429；AI_DISABLED 设为 "true" 可一键停用
    "DAILY_TEXT_LIMIT": "300",
    // MeloTTS 免费额度试用：限制每天新合成段数（不是 Cloudflare Neuron 用量的硬上限）
    "DAILY_TTS_LIMIT": "120",
    "PER_MINUTE_LIMIT": "40",
    "TTS_PER_MINUTE_LIMIT": "8",
    // 多用户：普通成员每人每天的额度（管理员只受上面的全站上限约束）；管理员邮箱用 GitHub Secret ADMIN_EMAILS 配置
    "USER_DAILY_TEXT_LIMIT": "60",
    "USER_DAILY_TTS_LIMIT": "60",
    "AI_DISABLED": "false",
    // 外部接口（/api/ext/lessons）限流：每人两次导入至少间隔多少秒、每天最多几次。换令牌也绕不过
    "EXT_IMPORT_INTERVAL": "180",
    "EXT_IMPORT_DAILY_LIMIT": "30"
    // Cloudflare Access 的 ACCESS_TEAM_DOMAIN / ACCESS_AUD 通过 GitHub Secrets 提供，不写在这里，
    // 这样 fork 之后不会连到别人的 Access。本地开发用 .dev.vars 里的 AUTH_DISABLED=true。
  },

  // 每小时整点检查一次要不要发每日提醒（Cron Triggers 免费）；不需要提醒可以删掉
  "triggers": { "crons": ["0 * * * *"] },

  "observability": { "enabled": true }
}
