# 复制为 .dev.vars 供本地 wrangler dev 使用（不会被提交）
GEMINI_API_KEY=your-gemini-api-key
# 可选：OpenAI。不填也能在设置页保存个人 key。默认模型 gpt-6-astra，默认地址 https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1
# 本地开发跳过 Cloudflare Access 校验；线上绝对不要设置
AUTH_DISABLED=true
# 可选：本地测试每日提醒，用 node scripts/vapid-keys.mjs 生成
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# 可选：「发现新词」读 Reddit 用的 script 应用
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
